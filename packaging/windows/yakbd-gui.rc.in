// Windows resources of yakbd-gui.exe (configured by CMake). yakbd.ico (and macos/yakbd.icns) are renderings of
// qml/icons/yakbd.svg. The version resource names the product and the editor's full version: every build of a
// release carries the same ones (code signing policy).
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/yakbd.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "The YAKBD contributors"
      VALUE "FileDescription", "YAKBD Editor"
      VALUE "FileVersion", "@YAKBD_GUI_VERSION_FULL@"
      VALUE "InternalName", "yakbd-gui"
      VALUE "LegalCopyright", "Copyright 2026 The YAKBD contributors (MIT-0)"
      VALUE "OriginalFilename", "yakbd-gui.exe"
      VALUE "ProductName", "YAKBD Editor"
      VALUE "ProductVersion", "@YAKBD_GUI_VERSION_FULL@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
