# Regenerates tools/qt-pins.cmake from Qt's public online repository (download.qt.io).
#
#   cmake -DQT_VERSION=6.12.1 -P tools/update-qt-pins.cmake
#
# For each platform it reads the repository's Updates.xml, takes the archive names and the build stamp of the
# packages listed below, downloads each archive's .sha1 file and writes the names and SHA-1 values into
# tools/qt-pins.cmake. tools/getqt.cmake then checks every archive against those committed values, so a changed
# archive on the server fails the download. Run it once per Qt bump and review the diff.

if(NOT QT_VERSION)
  message(FATAL_ERROR "pass -DQT_VERSION=x.y.z")
endif()
string(REPLACE "." "" vnodot "${QT_VERSION}")
set(base "https://download.qt.io/online/qtsdkrepository")
set(work "${CMAKE_CURRENT_LIST_DIR}/../build-qt-pins")
file(MAKE_DIRECTORY "${work}")

# platform | repository folder | package name | archive prefixes to keep
set(platforms
  "linux_gcc_64|linux_x64/desktop/qt6_${vnodot}/qt6_${vnodot}|qt.qt6.${vnodot}.linux_gcc_64|qtbase-,qtdeclarative-,qtsvg-,qtwayland-,icu-"
  "clang_64|mac_x64/desktop/qt6_${vnodot}/qt6_${vnodot}|qt.qt6.${vnodot}.clang_64|qtbase-,qtdeclarative-,qtsvg-"
  "win64_mingw|windows_x86/desktop/qt6_${vnodot}/qt6_${vnodot}_mingw|qt.qt6.${vnodot}.win64_mingw|qtbase-,qtdeclarative-,qtsvg-"
  "mingw_toolchain|windows_x86/desktop/tools_mingw1510|qt.tools.win64_mingw1510|mingw"
)

set(out "# Generated by tools/update-qt-pins.cmake for Qt ${QT_VERSION}. Do not edit by hand.\n")
string(APPEND out "set(QT_PIN_VERSION \"${QT_VERSION}\")\n")

foreach(entry IN LISTS platforms)
  string(REPLACE "|" ";" parts "${entry}")
  list(GET parts 0 plat)
  list(GET parts 1 folder)
  list(GET parts 2 pkg)
  list(SUBLIST parts 3 -1 prefixes)
  string(REPLACE "," ";" prefixes "${prefixes}")
  set(xml "${work}/${plat}-Updates.xml")
  file(DOWNLOAD "${base}/${folder}/Updates.xml" "${xml}" STATUS st)
  list(GET st 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "${plat}: Updates.xml: ${st}")
  endif()
  file(READ "${xml}" text)
  string(FIND "${text}" "<Name>${pkg}</Name>" at)
  if(at LESS 0)
    message(FATAL_ERROR "${plat}: package ${pkg} not in Updates.xml")
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(FIND "${rest}" "</PackageUpdate>" endAt)
  string(SUBSTRING "${rest}" 0 ${endAt} block)
  string(REGEX MATCH "<Version>([^<]*)</Version>" _ "${block}")
  set(version "${CMAKE_MATCH_1}")
  string(REGEX MATCH "<DownloadableArchives>([^<]*)</DownloadableArchives>" _ "${block}")
  string(REPLACE ", " ";" archives "${CMAKE_MATCH_1}")
  set(pins "")
  foreach(a IN LISTS archives)
    set(keep FALSE)
    foreach(p IN LISTS prefixes)
      string(FIND "${a}" "${p}" pos)
      if(pos EQUAL 0)
        set(keep TRUE)
      endif()
    endforeach()
    if(NOT keep)
      continue()
    endif()
    set(file "${version}${a}")
    file(DOWNLOAD "${base}/${folder}/${pkg}/${file}.sha1" "${work}/${file}.sha1" STATUS st)
    list(GET st 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "${file}.sha1: ${st}")
    endif()
    file(READ "${work}/${file}.sha1" sha)
    string(REGEX MATCH "[0-9a-f]+" sha "${sha}")
    list(APPEND pins "${file}" "${sha}")
    message(STATUS "${plat}: ${file} ${sha}")
  endforeach()
  string(APPEND out "set(QT_PIN_${plat}_URL \"${base}/${folder}/${pkg}\")\n")
  string(APPEND out "set(QT_PIN_${plat}\n")
  list(LENGTH pins n)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET pins ${i} f)
    list(GET pins ${j} s)
    string(APPEND out "  \"${f}\" ${s}\n")
  endforeach()
  string(APPEND out ")\n")
endforeach()

file(WRITE "${CMAKE_CURRENT_LIST_DIR}/qt-pins.cmake" "${out}")
file(REMOVE_RECURSE "${work}")
message(STATUS "wrote tools/qt-pins.cmake")
